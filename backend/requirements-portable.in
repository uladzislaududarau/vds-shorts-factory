# Runtime for every platform except Apple Silicon Macs (they use requirements-runtime.lock with MLX):
# Windows x64 and Linux x86_64/arm64 (Intel Macs: requirements-macos-intel.lock, same input). Resolved into requirements-portable.lock with:
#   .tools/uv pip compile backend/requirements-portable.in --universal --python-version 3.11 \
#     -c backend/portable-constraints.txt -o backend/requirements-portable.lock
# Same packages as the Apple Silicon lock, except speech recognition: faster-whisper (CTranslate2) instead of MLX.
fastapi
uvicorn
python-multipart
pydantic
google-genai
